{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron . --dev\"",
    "build:ui": "vite build",
    "start": "electron .",
    "test": "jest",
    "build:mac": "npm run build:ui && electron-builder --mac",
    "build:win": "npm run build:ui && electron-builder --win",
    "build:linux": "npm run build:ui && electron-builder --linux"
  },
  "build": {
    "appId": "com.mdforge.app",
    "productName": "MDForge",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mukilan03h/md-to-doc.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Mukilan03h/md-to-doc/issues"
  },
  "homepage": "https://github.com/Mukilan03h/md-to-doc#readme",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "electron-store": "^11.0.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.577.0",
    "marked": "^9.1.6",
    "mime-types": "^3.0.2",
    "puppeteer-core": "^24.39.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.8",
    "puppeteer": "^24.39.0",
    "tailwindcss": "^4.2.1",
    "vite": "^8.0.0",
    "wait-on": "^9.0.4"
  }
}
